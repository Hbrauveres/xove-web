{
  "name": "xove-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "node scripts/guard.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:styles": "node scripts/check-styles.ts",
    "test:alone": "node scripts/test-alone.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:code": "node scripts/check-code.ts",
    "check:copies": "jscpd",
    "check:unused": "knip --no-progress",
    "guard": "node scripts/guard.ts",
    "check:size": "node scripts/check-size.ts"
  },
  "dependencies": {
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jscpd": "4.3.0",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "oxlint": "1.89.0",
    "postcss": "^8.5.31",
    "postcss-custom-media": "^12.0.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# Serves the built React app. The server's shared proxy does TLS in front of it.
{
	admin off
	persist_config off
}

:80 {
	root * /srv
	encode zstd gzip
	log

	# Vite puts a content hash in every file name under /assets: cache them for a year.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The settings this app shares with the API, from the container's environment:
	# config/config.json filled in as it's served, never cached, so a new deploy's value shows on reload.
	handle /config.json {
		root * /etc/caddy/xove
		header Cache-Control "no-store"
		templates {
			mime application/json
		}
		file_server
	}

	# Every other path is a React Router route: serve index.html, never cache it.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

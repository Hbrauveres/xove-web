{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "no-unused-vars": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-params": ["error", 4],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1, -1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "typescript/ban-ts-comment": "error"
  },
  "overrides": [
    {
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes|features|shared)/|^(\\.\\./)+(routes|features|shared)(/|$)",
                "message": "services/ uses nothing else in the app"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes|features)/|^(\\.\\./)+(routes|features)(/|$)",
                "message": "shared/ may use services/ only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes)/|^(\\.\\./)+(routes)(/|$)",
                "message": "features/ may use shared/ and services/, never routes/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx", "src/testing/**", "scripts/**"],
      "rules": {
        "max-lines-per-function": "off",
        "complexity": "off",
        "max-depth": "off",
        "max-params": "off",
        "no-magic-numbers": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.js", "vite.config.ts", ".storybook/*.ts", "**/*.stories.tsx"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}

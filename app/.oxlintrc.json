{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./scripts/lint-plugin.ts", "eslint-plugin-regexp"],
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "xove/regexp-from-data": "error",
    "xove/slow-regexp": "error",
    "regexp/confusing-quantifier": "error",
    "regexp/no-contradiction-with-assertion": "error",
    "regexp/no-dupe-characters-character-class": "error",
    "regexp/no-dupe-disjunctions": "error",
    "regexp/no-empty-alternative": "error",
    "regexp/no-empty-capturing-group": "error",
    "regexp/no-empty-character-class": "error",
    "regexp/no-empty-group": "error",
    "regexp/no-empty-lookarounds-assertion": "error",
    "regexp/no-empty-string-literal": "error",
    "regexp/no-escape-backspace": "error",
    "regexp/no-invalid-regexp": "error",
    "regexp/no-invisible-character": "error",
    "regexp/no-lazy-ends": "error",
    "regexp/no-legacy-features": "error",
    "regexp/no-misleading-capturing-group": "error",
    "regexp/no-misleading-unicode-character": "error",
    "regexp/no-missing-g-flag": "error",
    "regexp/no-non-standard-flag": "error",
    "regexp/no-obscure-range": "error",
    "regexp/no-optional-assertion": "error",
    "regexp/no-potentially-useless-backreference": "error",
    "regexp/no-super-linear-backtracking": "error",
    "regexp/no-super-linear-move": "error",
    "regexp/no-useless-assertions": "error",
    "regexp/no-useless-backreference": "error",
    "regexp/no-useless-dollar-replacements": "error",
    "regexp/no-zero-quantifier": "error",
    "regexp/optimal-lookaround-quantifier": "error",
    "regexp/strict": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "no-unused-vars": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-params": ["error", 4],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1, -1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "typescript/ban-ts-comment": "error",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": ["tabpanel", "application"]
      }
    ],
    "jsx-a11y/media-has-caption": "off"
  },
  "overrides": [
    {
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes|features|shared)/|^(\\.\\./)+(routes|features|shared)(/|$)",
                "message": "services/ uses nothing else in the app"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes|features)/|^(\\.\\./)+(routes|features)(/|$)",
                "message": "shared/ may use services/ only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@(routes)/|^(\\.\\./)+(routes)(/|$)",
                "message": "features/ may use shared/ and services/, never routes/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx", "src/testing/**", "scripts/**", "e2e/**"],
      "rules": {
        "max-lines-per-function": "off",
        "complexity": "off",
        "max-depth": "off",
        "max-params": "off",
        "no-magic-numbers": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": [
        "*.config.ts",
        "*.config.js",
        "vite.config.ts",
        ".storybook/*.ts",
        "**/*.stories.tsx",
        "scripts/lint-plugin.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
